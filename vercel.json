{
  "version": 2,
  "buildCommand": "# This is a static site",
  "outputDirectory": "src",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.*\\.(js|css|jpg|jpeg|png|gif|svg|woff|woff2|ttf|eot)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.*\\.html$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

